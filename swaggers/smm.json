{
  "openapi": "3.0.0",
  "info": {
    "description": "External API for managing system",
    "version": "1.0.0",
    "title": "Stays API"
  },
  "servers": [
    {
      "url": "/external/v1",
      "description": "Main (production) server."
    }
  ],
  "security": [
    {
      "BasicAuth": []
    }
  ],
  "paths": {
    "/smm/threads": {
      "get": {
        "summary": "Gets a list of threads",
        "tags": [
          "SMM"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "from",
            "required": true,
            "description": "Start date to filter. Will filter only threads with last message date greater than this date",
            "schema": {
              "$ref": "#/components/schemas/DateString"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": true,
            "description": "End date to filter. Will filter only threads with last message date less than this date",
            "schema": {
              "$ref": "#/components/schemas/DateString"
            }
          },
          {
            "in": "query",
            "name": "channel",
            "required": false,
            "description": "Array of channels to filter",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "airbnb",
                  "bookingcom",
                  "expedia",
                  "whatsapp"
                ]
              }
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "description": "Status to filter",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "active",
                  "archive"
                ]
              }
            }
          },
          {
            "in": "query",
            "name": "type",
            "required": false,
            "description": "The type to filter. Can be 'any', 'noResYet', 'arrival', 'departure', 'lastAnswer'",
            "schema": {
              "type": "string",
              "enum": [
                "any",
                "noResYet",
                "arrival",
                "departure",
                "lastAnswer"
              ]
            }
          },
          {
            "in": "query",
            "name": "apartment",
            "required": false,
            "description": "Apartment ids to filter",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/DualID"
              }
            }
          },
          {
            "in": "query",
            "name": "reserveId",
            "required": false,
            "description": "UniqID, InternalID or partnerCode",
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/UniqID"
                },
                {
                  "$ref": "#/components/schemas/InternalID"
                },
                {
                  "$ref": "#/components/schemas/partnerCode"
                }
              ],
              "description": "Universal unique identifier, accepts long and short identifiers transparently"
            }
          },
          {
            "in": "query",
            "name": "contentSearch",
            "required": false,
            "description": "Search string to filter",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "onlyUnread",
            "required": false,
            "description": "Filter by unread status",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "skip",
            "required": false,
            "description": "Number of items to skip",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "description": "Amount of items to return",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of threads",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/thread"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Apartment not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          },
          "4XX": {
            "description": "HTTP Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          }
        }
      }
    },
    "/smm/threads/{threadId}": {
      "parameters": [
        {
          "in": "path",
          "name": "threadId",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/UniqID"
          }
        }
      ],
      "get": {
        "summary": "Gets a thread by id",
        "tags": [
          "SMM"
        ],
        "responses": {
          "200": {
            "description": "Thread object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/thread"
                }
              }
            }
          },
          "404": {
            "description": "Thread not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          },
          "4XX": {
            "description": "HTTP Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          }
        }
      }
    },
    "/smm/threads/{threadId}/messages": {
      "parameters": [
        {
          "in": "path",
          "name": "threadId",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/UniqID"
          }
        }
      ],
      "get": {
        "summary": "Gets a thread's array of messages by id",
        "tags": [
          "SMM"
        ],
        "responses": {
          "200": {
            "description": "Array of messages",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/threadMessage"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Thread not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          },
          "4XX": {
            "description": "HTTP Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Creates a new message in a thread",
        "tags": [
          "SMM"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "attachments": {
                    "type": "string",
                    "format": "binary"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Message created"
          },
          "404": {
            "description": "Thread not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          },
          "4XX": {
            "description": "HTTP Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BasicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "ClientEmails": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "adr": {
              "$ref": "#/components/schemas/Email",
              "description": "email address"
            },
            "type": {
              "type": "string",
              "description": "email type"
            },
            "hint": {
              "type": "string",
              "description": "email hint"
            }
          }
        }
      },
      "ClientPhones": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "iso": {
              "$ref": "#/components/schemas/Phonenumber"
            },
            "rawNum": {
              "type": "string",
              "description": "Raw phone number. This field is returned when system couldn't validate a phone number provided by client"
            },
            "hint": {
              "type": "string"
            }
          }
        }
      },
      "DateString": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "example": "2020-02-29"
      },
      "DateTimeString": {
        "type": "string",
        "format": "date-time"
      },
      "DualID": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/UniqID"
          },
          {
            "$ref": "#/components/schemas/InternalID"
          }
        ],
        "description": "Dual unique identifier, accepts long and short identifiers transparently"
      },
      "Email": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$"
      },
      "ErrorBase": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "text of error"
          }
        }
      },
      "InternalID": {
        "type": "string",
        "pattern": "^([A-Z]{2}[0-9]{2,4}[A-Z]{1})$",
        "description": "Short identifier that uniq for certain entity",
        "example": "XQ02F"
      },
      "Phonenumber": {
        "type": "string",
        "pattern": "^\\+(\\d+){7,23}$",
        "example": "+00000000000",
        "minLength": 8,
        "maxLength": 24
      },
      "ReservationType": {
        "type": "string",
        "enum": [
          "reserved",
          "booked",
          "contract",
          "blocked",
          "maintenance",
          "canceled"
        ]
      },
      "TimeString": {
        "type": "string",
        "pattern": "^\\d{2}:\\d{2}$",
        "example": "14:00"
      },
      "UniqID": {
        "type": "string",
        "pattern": "^([a-f0-9]){24}$",
        "description": "Hexadecimal unique identifier",
        "example": "5dee464910450609ca7ea2d7"
      },
      "fileType": {
        "type": "string",
        "enum": [
          "image/jpeg",
          "image/png",
          "image/webp",
          "image/avif",
          "image/gif",
          "application/pdf",
          "application/msword",
          "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
          "application/vnd.oasis.opendocument.text",
          "application/vnd.ms-excel",
          "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
          "application/vnd.oasis.opendocument.spreadsheet",
          "application/mp4",
          "video/mp4",
          "video/quicktime",
          "audio/ogg",
          "audio/mpeg",
          "text/html"
        ],
        "example": "image/jpeg"
      },
      "partnerCode": {
        "type": "string",
        "description": "Partner Code",
        "example": "A025-D2362"
      },
      "thread": {
        "type": "object",
        "properties": {
          "_id": {
            "$ref": "#/components/schemas/UniqID"
          },
          "_idthread": {
            "$ref": "#/components/schemas/UniqID"
          },
          "channel": {
            "type": "string",
            "enum": [
              "airbnb",
              "bookingcom",
              "expedia",
              "whatsapp"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "archived"
            ]
          },
          "reservation": {
            "$ref": "#/components/schemas/threadReservation"
          },
          "guest": {
            "type": "object",
            "properties": {
              "_id": {
                "$ref": "#/components/schemas/UniqID"
              },
              "name": {
                "type": "string"
              },
              "phones": {
                "$ref": "#/components/schemas/ClientPhones"
              },
              "emails": {
                "$ref": "#/components/schemas/ClientEmails"
              }
            }
          },
          "partner": {
            "type": "object",
            "properties": {
              "_id": {
                "$ref": "#/components/schemas/UniqID"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/threadMessage"
            }
          }
        }
      },
      "threadMessage": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "_dtmessage": {
            "$ref": "#/components/schemas/DateTimeString"
          },
          "creationDateTime": {
            "$ref": "#/components/schemas/DateTimeString",
            "description": "Message creation date and time with timezone"
          },
          "user": {
            "type": "object",
            "properties": {
              "_b_agent": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "agent",
                  "guest"
                ]
              }
            }
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "$ref": "#/components/schemas/fileType"
                },
                "title": {
                  "type": "string"
                },
                "_idfile": {
                  "$ref": "#/components/schemas/UniqID"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          },
          "source": {
            "type": "string",
            "enum": [
              "agency",
              "guest"
            ]
          },
          "agent": {
            "type": "object",
            "properties": {
              "_id": {
                "$ref": "#/components/schemas/UniqID"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "guest": {
            "type": "object",
            "properties": {
              "_id": {
                "$ref": "#/components/schemas/UniqID"
              },
              "name": {
                "type": "string"
              }
            }
          }
        }
      },
      "threadReservation": {
        "type": "object",
        "properties": {
          "_id": {
            "$ref": "#/components/schemas/UniqID"
          },
          "id": {
            "$ref": "#/components/schemas/InternalID"
          },
          "creationDate": {
            "$ref": "#/components/schemas/DateString"
          },
          "creationTime": {
            "$ref": "#/components/schemas/TimeString"
          },
          "creationDateTime": {
            "$ref": "#/components/schemas/DateTimeString",
            "description": "Reservation creation date and time with timezone"
          },
          "type": {
            "$ref": "#/components/schemas/ReservationType"
          },
          "_idlisting": {
            "$ref": "#/components/schemas/UniqID"
          },
          "checkInDate": {
            "$ref": "#/components/schemas/DateString"
          },
          "checkInTime": {
            "$ref": "#/components/schemas/TimeString"
          },
          "checkOutDate": {
            "$ref": "#/components/schemas/DateString"
          },
          "checkOutTime": {
            "$ref": "#/components/schemas/TimeString"
          },
          "_idclient": {
            "$ref": "#/components/schemas/UniqID"
          },
          "reservationUrl": {
            "type": "string",
            "description": "URL redirection to Stays system reservation page",
            "readOnly": true
          }
        }
      }
    }
  }
}