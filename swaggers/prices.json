{
  "openapi": "3.0.0",
  "info": {
    "description": "External API for managing system",
    "version": "1.0.0",
    "title": "Stays API"
  },
  "servers": [
    {
      "url": "/external/v1",
      "description": "Main (production) server."
    }
  ],
  "security": [
    {
      "BasicAuth": []
    }
  ],
  "paths": {
    "/parr/price-regions": {
      "get": {
        "summary": "Returns price regions list.",
        "tags": [
          "parr"
        ],
        "responses": {
          "200": {
            "description": "Ok!",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PriceRegion"
                  }
                }
              }
            }
          },
          "4XX": {
            "description": "HTTP Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create new price region.",
        "tags": [
          "parr"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PriceRegionEditable"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Region item has been created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PriceRegion"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameter in request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          },
          "409": {
            "description": "Item already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          },
          "4XX": {
            "description": "HTTP Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          }
        }
      }
    },
    "/parr/price-regions/{regionId}": {
      "patch": {
        "summary": "Update the price region",
        "tags": [
          "parr"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "regionId",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/UniqID"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PriceRegionEditable"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Price region updated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PriceRegionEditable"
                }
              }
            }
          },
          "400": {
            "description": "invalid input, object invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          },
          "404": {
            "description": "Item doesn't exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          },
          "4XX": {
            "description": "HTTP Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Remove the price region.",
        "tags": [
          "parr"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "regionId",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/UniqID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "the item has been deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PriceRegionEditable"
                }
              }
            }
          },
          "400": {
            "description": "Bad input parameter!",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          },
          "404": {
            "description": "Item doesn't exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          },
          "4XX": {
            "description": "HTTP Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          }
        }
      }
    },
    "/parr/seasons-sell": {
      "get": {
        "summary": "Returns seasons list.",
        "tags": [
          "parr"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "_idregion",
            "description": "ID season's region. Empty for default.",
            "schema": {
              "$ref": "#/components/schemas/UniqID"
            }
          },
          {
            "in": "query",
            "name": "from",
            "description": "Start date for searching",
            "schema": {
              "$ref": "#/components/schemas/DateString"
            }
          },
          {
            "in": "query",
            "name": "to",
            "description": "End date for searching",
            "schema": {
              "$ref": "#/components/schemas/DateString"
            }
          },
          {
            "in": "query",
            "name": "status",
            "description": "Status of season",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "inactive"
              ],
              "default": "active"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok!",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SeasonSell"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameter in request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          },
          "4XX": {
            "description": "HTTP Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create new season.",
        "tags": [
          "parr"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SeasonSell"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Season created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeasonSell"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameter in request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          },
          "4XX": {
            "description": "HTTP Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          }
        }
      }
    },
    "/parr/seasons-sell/{seasonId}": {
      "get": {
        "summary": "Returns the season by ID.",
        "tags": [
          "parr"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "seasonId",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/UniqID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok!",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeasonSell"
                }
              }
            }
          },
          "400": {
            "description": "bad input parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          },
          "404": {
            "description": "Item doesn't exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          },
          "4XX": {
            "description": "HTTP Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update the season",
        "tags": [
          "parr"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "seasonId",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/UniqID"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SeasonSell"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Season updated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeasonSell"
                }
              }
            }
          },
          "400": {
            "description": "invalid input, object invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          },
          "404": {
            "description": "Item doesn't exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          },
          "4XX": {
            "description": "HTTP Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Remove the season.",
        "tags": [
          "parr"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "seasonId",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/UniqID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "the item has been deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeasonSell"
                }
              }
            }
          },
          "400": {
            "description": "Bad input parameter!",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          },
          "404": {
            "description": "Item doesn't exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          },
          "4XX": {
            "description": "HTTP Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          }
        }
      }
    },
    "/parr/listing-rates-sell": {
      "parameters": [
        {
          "in": "query",
          "name": "listingId",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/DualID"
          }
        },
        {
          "in": "query",
          "name": "from",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/DateString"
          }
        },
        {
          "in": "query",
          "name": "to",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/DateString"
          }
        }
      ],
      "get": {
        "summary": "Returns season rates sell for certain listing",
        "tags": [
          "parr"
        ],
        "responses": {
          "200": {
            "description": "Ok!",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ListingRateItem"
                  }
                }
              }
            }
          },
          "4XX": {
            "description": "HTTP Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          }
        }
      }
    },
    "/parr/listing-rates-sell/{seasonId}": {
      "parameters": [
        {
          "in": "path",
          "name": "seasonId",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/UniqID"
          }
        },
        {
          "in": "query",
          "name": "listingId",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/DualID"
          }
        }
      ],
      "get": {
        "summary": "Returns season rate sell for certain listing",
        "tags": [
          "parr"
        ],
        "responses": {
          "200": {
            "description": "Ok!",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListingRateItem"
                }
              }
            }
          },
          "404": {
            "description": "Item doesn't exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          },
          "4XX": {
            "description": "HTTP Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Updates rate sell for certain listing and season.",
        "tags": [
          "parr"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/ListingRateGlobalEditable"
                  },
                  {
                    "$ref": "#/components/schemas/ListingRateIndividualEditable"
                  }
                ],
                "discriminator": {
                  "propertyName": "type",
                  "mapping": {
                    "global": "#/components/schemas/ListingRateGlobalEditable",
                    "individual": "#/components/schemas/ListingRateIndividualEditable"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "the item is updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListingRateItem"
                }
              }
            }
          },
          "404": {
            "description": "Item doesn't exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          },
          "4XX": {
            "description": "HTTP Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BasicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "DateString": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "example": "2020-02-29"
      },
      "DualID": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/UniqID"
          },
          {
            "$ref": "#/components/schemas/InternalID"
          }
        ],
        "description": "Dual unique identifier, accepts long and short identifiers transparently"
      },
      "ErrorBase": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "text of error"
          }
        }
      },
      "InternalID": {
        "type": "string",
        "pattern": "^([A-Z]{2}[0-9]{2,4}[A-Z]{1})$",
        "description": "Short identifier that uniq for certain entity",
        "example": "XQ02F"
      },
      "ListingRateGlobalEditable": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "global"
            ],
            "description": "Indicates if rate uses global settings or individual"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ]
          },
          "baseRateValue": {
            "type": "number"
          },
          "monthlyRateValue": {
            "type": "number"
          }
        }
      },
      "ListingRateIndividualEditable": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "individual"
            ],
            "description": "Indicates if rate uses global settings or individual"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ]
          },
          "from": {
            "$ref": "#/components/schemas/DateString",
            "description": "Individual start date. Optional. Applicable for events only."
          },
          "to": {
            "$ref": "#/components/schemas/DateString",
            "description": "Individual end date. Optional. Applicable for events only."
          },
          "baseRateValue": {
            "type": "number"
          },
          "monthlyRateValue": {
            "type": "number"
          },
          "ratePlans": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "minStay",
                    "_f_val"
                  ],
                  "properties": {
                    "minStay": {
                      "type": "integer"
                    },
                    "_f_val": {
                      "type": "number"
                    }
                  },
                  "minProperties": 2,
                  "maxProperties": 2
                }
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "minStay",
                    "_i_percent"
                  ],
                  "properties": {
                    "minStay": {
                      "type": "integer"
                    },
                    "_i_percent": {
                      "type": "number"
                    }
                  },
                  "minProperties": 2,
                  "maxProperties": 2
                }
              }
            ]
          }
        }
      },
      "ListingRateItem": {
        "type": "object",
        "properties": {
          "_idlisting": {
            "$ref": "#/components/schemas/UniqID"
          },
          "_idseason": {
            "$ref": "#/components/schemas/UniqID"
          },
          "type": {
            "type": "string",
            "enum": [
              "global",
              "individual"
            ],
            "description": "Indicates if rate uses global settings or individual"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ]
          },
          "from": {
            "$ref": "#/components/schemas/DateString",
            "description": "Start date"
          },
          "to": {
            "$ref": "#/components/schemas/DateString",
            "description": "End date"
          },
          "individualDates": {
            "type": "boolean",
            "description": "Indicates that global season dates is overwritten"
          },
          "baseRateValue": {
            "type": "number"
          },
          "ratePlans": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "minStay": {
                  "type": "integer"
                },
                "_i_percent": {
                  "type": "integer"
                },
                "_f_val": {
                  "type": "number"
                }
              }
            }
          },
          "monthlyRate": {
            "type": "object",
            "properties": {
              "minStay": {
                "type": "integer"
              },
              "_f_val": {
                "type": "number"
              }
            }
          }
        }
      },
      "PriceRegion": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "_id": {
                "$ref": "#/components/schemas/UniqID",
                "description": "Unique object identifier"
              }
            }
          },
          {
            "$ref": "#/components/schemas/PriceRegionEditable"
          }
        ]
      },
      "PriceRegionEditable": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Region name"
          }
        },
        "description": "Represent editable part of price region item"
      },
      "SeasonSell": {
        "type": "object",
        "properties": {
          "_id": {
            "$ref": "#/components/schemas/UniqID"
          },
          "type": {
            "type": "string",
            "enum": [
              "season",
              "event"
            ],
            "description": "Identify season type - regular or event"
          },
          "name": {
            "type": "string",
            "description": "Season internal name"
          },
          "hint": {
            "type": "string",
            "description": "Season hint, to allow better identify it"
          },
          "from": {
            "$ref": "#/components/schemas/DateString"
          },
          "to": {
            "$ref": "#/components/schemas/DateString"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ],
            "description": "Shows current status of season"
          },
          "ratePlans": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "minStay": {
                  "type": "integer",
                  "description": "Minimal nights stay to apply this rate"
                },
                "_i_percent": {
                  "type": "integer",
                  "description": "Percentage discount from base rate. Base rate - rate with minimal nights. For base rate, this value is zero"
                }
              }
            }
          },
          "useMonthlyRate": {
            "type": "boolean",
            "description": "Indicates if season has monthly rates. Applicable only for type 'season'"
          }
        }
      },
      "UniqID": {
        "type": "string",
        "pattern": "^([a-f0-9]){24}$",
        "description": "Hexadecimal unique identifier",
        "example": "5dee464910450609ca7ea2d7"
      }
    }
  }
}