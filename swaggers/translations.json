      "get": {
        "summary": "Returns multilang list of multi-unit property types",
        "tags": [
          "Translation"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "searchString",
            "description": "Pass an optional search string for looking",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A JSON array of types",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranslationsList"
                }
              }
            }
          },
          "4XX": {
            "description": "HTTP Error",
            "content": {
              "application/json": {
                "schema": {
