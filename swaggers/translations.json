  "components": {
    "securitySchemes": {
      "BasicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "ErrorBase": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "text of error"
          }
        }
      },
      "MultiLang": {
        "type": "object",
        "properties": {
          "en_US": {
            "type": "string"
          },
          "pt_BR": {
            "type": "string"
          },
          "de_DE": {
            "type": "string"
          },
          "es_ES": {
            "type": "string"
          },
          "pt_PT": {
            "type": "string"
          },
          "ru_RU": {
            "type": "string"
          },
          "sv_SE": {
            "type": "string"
          },
          "it_IT": {
            "type": "string"
          },
          "fr_FR": {
            "type": "string"
          },
          "el_GR": {
            "type": "string"
          }
        },
        "minProperties": 1,
        "description": "Used for describing multilanguage data. Keys of the object are ISO locale code"
      },
      "Translation": {
        "type": "object",
        "required": [
          "_id",
          "_mstitle"
        ],
        "properties": {
          "_id": {
            "$ref": "#/components/schemas/UniqID"
          },
          "_mstitle": {
            "$ref": "#/components/schemas/MultiLang"
          }
        }
      },
      "TranslationsList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Translation"
        }
      },
      "UniqID": {
        "type": "string",
        "pattern": "^([a-f0-9]){24}$",
        "description": "Hexadecimal unique identifier",
        "example": "5dee464910450609ca7ea2d7"
      },
      "communicationWay": {
        "type": "object",
        "properties": {
          "_id": {
            "$ref": "#/components/schemas/UniqID"
          },
          "type": {
            "type": "string"
          },
          "_msname": {
            "$ref": "#/components/schemas/MultiLang"
          }
        }
      },
      "marketingSource": {
        "type": "object",
        "properties": {
          "_id": {
            "$ref": "#/components/schemas/UniqID"
          },
          "type": {
            "type": "string"
          },
          "_msname": {
            "$ref": "#/components/schemas/MultiLang"
          }
        }
      }
    }
  }
}