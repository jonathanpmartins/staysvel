{
  "openapi": "3.0.0",
  "info": {
    "description": "External API for managing system",
    "version": "1.0.0",
    "title": "Stays API"
  },
  "servers": [
    {
      "url": "/external/v1",
      "description": "Main (production) server."
    }
  ],
  "security": [
    {
      "BasicAuth": []
    }
  ],
  "paths": {
    "/calendar/listing/{listingId}/prices": {
      "parameters": [
        {
          "in": "path",
          "name": "listingId",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/DualID"
          }
        }
      ],
      "patch": {
        "summary": "Update rate values.",
        "deprecated": true,
        "tags": [
          "Calendar"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "from",
                  "to",
                  "prices"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "format": "date"
                  },
                  "to": {
                    "type": "string",
                    "format": "date"
                  },
                  "prices": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "minStay",
                        "_f_val"
                      ],
                      "properties": {
                        "minStay": {
                          "type": "integer",
                          "minimum": 1,
                          "example": 1
                        },
                        "_f_val": {
                          "type": "number",
                          "minimum": 0,
                          "exclusiveMinimum": true,
                          "example": 50
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item updated successfully.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "4XX": {
            "description": "HTTP Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          }
        }
      }
    },
    "/calendar/listing/{listingId}/restrictions": {
      "parameters": [
        {
          "in": "path",
          "name": "listingId",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/DualID"
          }
        }
      ],
      "patch": {
        "summary": "Update restriction.",
        "deprecated": true,
        "tags": [
          "Calendar"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "from",
                  "to",
                  "closedToArrival",
                  "closedToDeparture"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "format": "date"
                  },
                  "to": {
                    "type": "string",
                    "format": "date"
                  },
                  "closedToArrival": {
                    "type": "boolean"
                  },
                  "closedToDeparture": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item updated successfully.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "4XX": {
            "description": "HTTP Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          }
        }
      }
    },
    "/calendar/listing/{listingId}/batch": {
      "parameters": [
        {
          "in": "path",
          "name": "listingId",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/DualID"
          }
        },
        {
          "in": "query",
          "name": "pricingModel",
          "required": false,
          "schema": {
            "type": "string",
            "enum": [
              "rateplans",
              "losd"
            ]
          }
        }
      ],
      "patch": {
        "summary": "Update prices and restrictions in batch.",
        "tags": [
          "Calendar"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/CalendarBatchRatePlansBody"
                  },
                  {
                    "$ref": "#/components/schemas/CalendarBatchLosdBody"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item updated successfully.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "4XX": {
            "description": "HTTP Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          }
        }
      }
    },
    "/calendar/listing/{listingId}": {
      "parameters": [
        {
          "in": "path",
          "name": "listingId",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/DualID"
          }
        }
      ],
      "get": {
        "summary": "Returns calendar data for certain listing",
        "tags": [
          "Calendar"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "from",
            "required": true,
            "description": "Start date.",
            "schema": {
              "$ref": "#/components/schemas/DateString"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": true,
            "description": "End date.",
            "schema": {
              "$ref": "#/components/schemas/DateString"
            }
          },
          {
            "in": "query",
            "name": "ignorePriceGroupUnits",
            "required": false,
            "description": "Ignore availability for price group units. Only master listing availability will be returned.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "ignoreCloneGroupUnits",
            "required": false,
            "description": "Ignore availability for clone group units. Only master listing availability will be returned",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "availNoPrices",
            "required": false,
            "description": "Return real availability when no prices defined",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "includeBlockedCount",
            "required": false,
            "description": "Include number of blocked units for each day in the response",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of calendar items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CalendarItem"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameter in request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          },
          "404": {
            "description": "Item doesn't exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          },
          "4XX": {
            "description": "HTTP Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BasicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "CalendarBatchLosdBody": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "from",
            "to",
            "baseRate"
          ],
          "properties": {
            "from": {
              "$ref": "#/components/schemas/DateString",
              "description": "Start date."
            },
            "to": {
              "$ref": "#/components/schemas/DateString",
              "description": "End date."
            },
            "closedToArrival": {
              "type": "boolean"
            },
            "closedToDeparture": {
              "type": "boolean"
            },
            "baseRate": {
              "type": "object",
              "required": [
                "minStay",
                "_f_val"
              ],
              "properties": {
                "minStay": {
                  "type": "integer",
                  "minimum": 1,
                  "example": 1
                },
                "_f_val": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMinimum": true,
                  "example": 50
                }
              }
            }
          }
        }
      },
      "CalendarBatchRatePlansBody": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "from",
            "to",
            "prices"
          ],
          "properties": {
            "from": {
              "$ref": "#/components/schemas/DateString",
              "description": "Start date."
            },
            "to": {
              "$ref": "#/components/schemas/DateString",
              "description": "End date."
            },
            "closedToArrival": {
              "type": "boolean"
            },
            "closedToDeparture": {
              "type": "boolean"
            },
            "prices": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "minStay",
                  "_f_val"
                ],
                "properties": {
                  "minStay": {
                    "type": "integer",
                    "minimum": 1,
                    "example": 1
                  },
                  "_f_val": {
                    "type": "number",
                    "minimum": 0,
                    "exclusiveMinimum": true,
                    "example": 50
                  }
                }
              }
            }
          }
        }
      },
      "CalendarItem": {
        "type": "object",
        "required": [
          "date",
          "avail",
          "closedToArrival",
          "closedToDeparture"
        ],
        "properties": {
          "date": {
            "$ref": "#/components/schemas/DateString"
          },
          "avail": {
            "type": "number",
            "description": "Number of available units"
          },
          "blockedCount": {
            "type": "number",
            "description": "Number of blocked units (only included when includeBlockedCount query parameter is set)"
          },
          "closedToArrival": {
            "type": "boolean",
            "description": "Indicates if listing is not available for arrival"
          },
          "closedToDeparture": {
            "type": "boolean",
            "description": "Indicates if listing is not available for departure"
          },
          "prices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "minStay": {
                  "type": "number",
                  "description": "Indicates minimal number of nights to apply this price"
                },
                "_mcval": {
                  "$ref": "#/components/schemas/MultiCurrency"
                }
              }
            }
          },
          "monthlyPrice": {
            "type": "object",
            "properties": {
              "minStay": {
                "type": "number",
                "description": "Indicates minimal number of nights to apply this price"
              },
              "_mcval": {
                "$ref": "#/components/schemas/MultiCurrency"
              }
            }
          }
        }
      },
      "DateString": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "example": "2020-02-29"
      },
      "DualID": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/UniqID"
          },
          {
            "$ref": "#/components/schemas/InternalID"
          }
        ],
        "description": "Dual unique identifier, accepts long and short identifiers transparently"
      },
      "ErrorBase": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "text of error"
          }
        }
      },
      "InternalID": {
        "type": "string",
        "pattern": "^([A-Z]{2}[0-9]{2,4}[A-Z]{1})$",
        "description": "Short identifier that uniq for certain entity",
        "example": "XQ02F"
      },
      "MultiCurrency": {
        "type": "object",
        "properties": {
          "BRL": {
            "type": "number"
          },
          "USD": {
            "type": "number"
          },
          "EUR": {
            "type": "number"
          },
          "MXN": {
            "type": "number"
          },
          "ARS": {
            "type": "number"
          },
          "UYU": {
            "type": "number"
          },
          "PYG": {
            "type": "number"
          },
          "CLP": {
            "type": "number"
          },
          "COP": {
            "type": "number"
          },
          "ZAR": {
            "type": "number"
          },
          "XAF": {
            "type": "number"
          },
          "BWP": {
            "type": "number"
          },
          "MZN": {
            "type": "number"
          },
          "NAD": {
            "type": "number"
          },
          "SZL": {
            "type": "number"
          },
          "LSL": {
            "type": "number"
          },
          "AED": {
            "type": "number"
          },
          "PEN": {
            "type": "number"
          },
          "GBP": {
            "type": "number"
          },
          "AUD": {
            "type": "number"
          },
          "RUB": {
            "type": "number"
          },
          "THB": {
            "type": "number"
          },
          "DOP": {
            "type": "number"
          },
          "CRC": {
            "type": "number"
          },
          "SEK": {
            "type": "number"
          },
          "IDR": {
            "type": "number"
          },
          "CAD": {
            "type": "number"
          },
          "NOK": {
            "type": "number"
          },
          "GTQ": {
            "type": "number"
          },
          "CHF": {
            "type": "number"
          }
        },
        "minProperties": 1,
        "description": "Used for describing prices in different currencies."
      },
      "UniqID": {
        "type": "string",
        "pattern": "^([a-f0-9]){24}$",
        "description": "Hexadecimal unique identifier",
        "example": "5dee464910450609ca7ea2d7"
      }
    }
  }
}