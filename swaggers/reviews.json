{
  "openapi": "3.0.0",
  "info": {
    "description": "External API for managing system",
    "version": "1.0.0",
    "title": "Stays API"
  },
  "servers": [
    {
      "url": "/external/v1",
      "description": "Main (production) server."
    }
  ],
  "security": [
    {
      "BasicAuth": []
    }
  ],
  "paths": {
    "/reviews/guest": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "from",
            "required": true,
            "description": "Start date.",
            "schema": {
              "$ref": "#/components/schemas/DateString"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": true,
            "description": "End date.",
            "schema": {
              "$ref": "#/components/schemas/DateString"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "description": "Number of results to return per page. Must be between 1 and 100.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "description": "Specifies the page number of the results to retrieve. Used in conjunction with the 'page size' parameter to implement pagination.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "clientId",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/UniqID"
            }
          },
          {
            "in": "query",
            "name": "listingId",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/DualID"
            }
          },
          {
            "in": "query",
            "name": "reserveId",
            "description": "UniqID, InternalID or partnerCode",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/UniqID"
                },
                {
                  "$ref": "#/components/schemas/InternalID"
                },
                {
                  "$ref": "#/components/schemas/partnerCode"
                }
              ],
              "description": "Universal unique identifier, accepts long and short identifiers transparently"
            }
          }
        ],
        "summary": "Retrieve guest reviews",
        "tags": [
          "Reviews"
        ],
        "responses": {
          "200": {
            "description": "Array of review items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "totalReviews": {
                      "description": "Total number of reviews found, within the specified params.",
                      "type": "integer",
                      "example": 2
                    },
                    "reviewList": {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "$ref": "#/components/schemas/ReviewGuestInternal"
                          },
                          {
                            "$ref": "#/components/schemas/ReviewGuestAirbnb"
                          },
                          {
                            "$ref": "#/components/schemas/ReviewGuestBookingcom"
                          },
                          {
                            "$ref": "#/components/schemas/ReviewGuestExpedia"
                          }
                        ],
                        "discriminator": {
                          "propertyName": "source",
                          "mapping": {
                            "internal": "#/components/schemas/ReviewGuestInternal",
                            "airbnb": "#/components/schemas/ReviewGuestAirbnb",
                            "bookingcom": "#/components/schemas/ReviewGuestBookingcom",
                            "expedia": "#/components/schemas/ReviewGuestExpedia"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "4XX": {
            "description": "HTTP Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new guest internal review",
        "tags": [
          "Reviews"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "day",
                  "cleaningRating",
                  "checkinRating",
                  "checkoutRating",
                  "reservationRating",
                  "maintenanceRating",
                  "treatmentRating",
                  "rating",
                  "positiveTraits",
                  "negativeTraits",
                  "reviewText"
                ],
                "$ref": "#/components/schemas/ReviewGuestBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Review created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewGuestInternal"
                }
              }
            }
          },
          "4XX": {
            "description": "HTTP Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          }
        }
      }
    },
    "/reviews/guest/{reviewId}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "reviewId",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/UniqID"
            }
          }
        ],
        "summary": "Retrieve a guest review",
        "tags": [
          "Reviews"
        ],
        "responses": {
          "200": {
            "description": "Review items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "review": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/ReviewGuestInternal"
                        },
                        {
                          "$ref": "#/components/schemas/ReviewGuestAirbnb"
                        },
                        {
                          "$ref": "#/components/schemas/ReviewGuestBookingcom"
                        },
                        {
                          "$ref": "#/components/schemas/ReviewGuestExpedia"
                        }
                      ],
                      "discriminator": {
                        "propertyName": "source",
                        "mapping": {
                          "internal": "#/components/schemas/ReviewGuestInternal",
                          "airbnb": "#/components/schemas/ReviewGuestAirbnb",
                          "bookingcom": "#/components/schemas/ReviewGuestBookingcom",
                          "expedia": "#/components/schemas/ReviewGuestExpedia"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "4XX": {
            "description": "HTTP Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update a guest internal review",
        "tags": [
          "Reviews"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "reviewId",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/UniqID"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewGuestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Review updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewGuestInternal"
                }
              }
            }
          },
          "4XX": {
            "description": "HTTP Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BasicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "DateString": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "example": "2020-02-29"
      },
      "DualID": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/UniqID"
          },
          {
            "$ref": "#/components/schemas/InternalID"
          }
        ],
        "description": "Dual unique identifier, accepts long and short identifiers transparently"
      },
      "ErrorBase": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "text of error"
          }
        }
      },
      "InternalID": {
        "type": "string",
        "pattern": "^([A-Z]{2}[0-9]{2,4}[A-Z]{1})$",
        "description": "Short identifier that uniq for certain entity",
        "example": "XQ02F"
      },
      "ReviewGuestAirbnb": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ReviewGuestBaseItem"
          },
          {
            "$ref": "#/components/schemas/ReviewGuestAirbnbItem"
          }
        ]
      },
      "ReviewGuestAirbnbItem": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "airbnb"
            ]
          },
          "accuracyRating": {
            "type": "number"
          },
          "checkinRating": {
            "type": "number"
          },
          "cleanlinessRating": {
            "type": "number"
          },
          "communicationRating": {
            "type": "number"
          },
          "locationRating": {
            "type": "number"
          },
          "valueRating": {
            "type": "number"
          },
          "accuracyComment": {
            "type": "string"
          },
          "checkinComment": {
            "type": "string"
          },
          "cleanlinessComment": {
            "type": "string"
          },
          "communicationComment": {
            "type": "string"
          },
          "locationComment": {
            "type": "string"
          },
          "valueComment": {
            "type": "string"
          },
          "privateFeedback": {
            "type": "string",
            "description": "Guest\u2019s private note to host (not publicly visible on Airbnb)"
          },
          "publicReview": {
            "type": "string",
            "description": "Guest\u2019s public review text on Airbnb"
          },
          "hostResponse": {
            "type": "string",
            "description": "Host\u2019s response text as stored by Airbnb"
          }
        }
      },
      "ReviewGuestBaseItem": {
        "type": "object",
        "properties": {
          "_id": {
            "$ref": "#/components/schemas/UniqID"
          },
          "status": {
            "type": "string"
          },
          "day": {
            "type": "string",
            "format": "date"
          },
          "apartment": {
            "type": "object",
            "properties": {
              "_id": {
                "$ref": "#/components/schemas/UniqID"
              },
              "avatar": {
                "type": "string"
              },
              "id": {
                "$ref": "#/components/schemas/InternalID"
              }
            }
          },
          "client": {
            "type": "object",
            "properties": {
              "_id": {
                "$ref": "#/components/schemas/UniqID"
              },
              "fName": {
                "type": "string",
                "description": "First name. Applicable for personal account"
              },
              "lName": {
                "type": "string",
                "description": "Last name. Applicable for personal account"
              }
            }
          },
          "partner": {
            "type": "object",
            "properties": {
              "_id": {
                "$ref": "#/components/schemas/UniqID"
              },
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "_idpartner": {
                "$ref": "#/components/schemas/UniqID"
              }
            }
          },
          "responser": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "_id": {
                "$ref": "#/components/schemas/UniqID"
              }
            }
          },
          "cleanUser": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "_id": {
                "$ref": "#/components/schemas/UniqID"
              }
            }
          },
          "checkInUser": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "_id": {
                "$ref": "#/components/schemas/UniqID"
              }
            }
          },
          "checkOutUser": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "_id": {
                "$ref": "#/components/schemas/UniqID"
              }
            }
          },
          "reserve": {
            "type": "object",
            "properties": {
              "_id": {
                "$ref": "#/components/schemas/UniqID"
              },
              "id": {
                "$ref": "#/components/schemas/InternalID"
              }
            }
          }
        }
      },
      "ReviewGuestBody": {
        "type": "object",
        "properties": {
          "day": {
            "description": "Date of the review",
            "$ref": "#/components/schemas/DateString"
          },
          "cleaningRating": {
            "type": "number",
            "description": "Cleaning rating",
            "minimum": 1,
            "maximum": 5
          },
          "checkinRating": {
            "type": "number",
            "description": "Check-in rating",
            "minimum": 1,
            "maximum": 5
          },
          "checkoutRating": {
            "type": "number",
            "description": "Check-out rating",
            "minimum": 1,
            "maximum": 5
          },
          "reservationRating": {
            "type": "number",
            "description": "Reservation rating",
            "minimum": 1,
            "maximum": 5
          },
          "maintenanceRating": {
            "type": "number",
            "description": "Maintenance rating",
            "minimum": 1,
            "maximum": 5
          },
          "treatmentRating": {
            "type": "number",
            "description": "Treatment rating",
            "minimum": 1,
            "maximum": 5
          },
          "rating": {
            "type": "number",
            "description": "Overall rating",
            "minimum": 1,
            "maximum": 5
          },
          "positiveTraits": {
            "type": "string",
            "description": "Positive feedback"
          },
          "negativeTraits": {
            "type": "string",
            "description": "Negative feedback"
          },
          "reviewText": {
            "type": "string",
            "description": "Review text"
          },
          "clientName": {
            "type": "string",
            "description": "Client name"
          },
          "clientId": {
            "$ref": "#/components/schemas/UniqID",
            "description": "Client identifier"
          },
          "partnerId": {
            "$ref": "#/components/schemas/UniqID",
            "description": "Partner identifier"
          },
          "listingId": {
            "description": "Listing identifier",
            "$ref": "#/components/schemas/DualID"
          },
          "reserveId": {
            "description": "Booking identifier",
            "$ref": "#/components/schemas/DualID"
          }
        }
      },
      "ReviewGuestBookingcom": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ReviewGuestBaseItem"
          },
          {
            "$ref": "#/components/schemas/ReviewGuestBookingcomItem"
          }
        ]
      },
      "ReviewGuestBookingcomItem": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "bookingcom"
            ]
          },
          "headlineComment": {
            "type": "string"
          },
          "positiveComment": {
            "type": "string"
          },
          "negativeComment": {
            "type": "string"
          },
          "originalCleanRating": {
            "type": "number"
          },
          "originalFacilitiesRating": {
            "type": "number"
          },
          "originalLocationRating": {
            "type": "number"
          },
          "originalServicesRating": {
            "type": "number"
          },
          "originalStaffRating": {
            "type": "number"
          },
          "originalValueRating": {
            "type": "number"
          },
          "originalRating": {
            "type": "number"
          },
          "cleanRating": {
            "type": "number"
          },
          "facilitiesRating": {
            "type": "number"
          },
          "locationRating": {
            "type": "number"
          },
          "staffRating": {
            "type": "number"
          },
          "valueRating": {
            "type": "number"
          },
          "rating": {
            "type": "number"
          }
        }
      },
      "ReviewGuestExpedia": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ReviewGuestBaseItem"
          },
          {
            "$ref": "#/components/schemas/ReviewGuestExpediaItem"
          }
        ]
      },
      "ReviewGuestExpediaItem": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "expedia"
            ]
          },
          "rating": {
            "type": "number"
          },
          "ecoFriendlinessRating": {
            "type": "number"
          },
          "overallRating": {
            "type": "number"
          },
          "communicationRating": {
            "type": "number"
          },
          "roomAmenitiesScoreRating": {
            "type": "number"
          },
          "hotelConditionRating": {
            "type": "number"
          },
          "roomCleanRating": {
            "type": "number"
          },
          "publicReview": {
            "type": "string"
          }
        }
      },
      "ReviewGuestInternal": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ReviewGuestBaseItem"
          },
          {
            "$ref": "#/components/schemas/ReviewGuestInternalItem"
          }
        ]
      },
      "ReviewGuestInternalItem": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "internal"
            ]
          },
          "cleaningRating": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "checkinRating": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "checkoutRating": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "reservationRating": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "maintenanceRating": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "treatmentRating": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "rating": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "positiveTraits": {
            "type": "string"
          },
          "negativeTraits": {
            "type": "string"
          },
          "reviewText": {
            "type": "string"
          },
          "hostResponse": {
            "type": "string",
            "description": "Host\u2019s public reply to the guest review (when available across channels)"
          }
        }
      },
      "UniqID": {
        "type": "string",
        "pattern": "^([a-f0-9]){24}$",
        "description": "Hexadecimal unique identifier",
        "example": "5dee464910450609ca7ea2d7"
      },
      "partnerCode": {
        "type": "string",
        "description": "Partner Code",
        "example": "A025-D2362"
      }
    }
  }
}