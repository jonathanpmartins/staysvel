{
  "openapi": "3.0.0",
  "info": {
    "description": "External API for managing system",
    "version": "1.0.0",
    "title": "Stays API"
  },
  "servers": [
    {
      "url": "/external/v1",
      "description": "Main (production) server."
    }
  ],
  "security": [
    {
      "BasicAuth": []
    }
  ],
  "paths": {
    "/book-request": {
      "post": {
        "summary": "Checks booking possibility and returns url that you have to redirect guest to complete checkout process.",
        "tags": [
          "Booking"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "from",
                  "to",
                  "aptid",
                  "client"
                ],
                "properties": {
                  "from": {
                    "$ref": "#/components/schemas/DateString",
                    "description": "Start date."
                  },
                  "to": {
                    "$ref": "#/components/schemas/DateString",
                    "description": "End date."
                  },
                  "aptid": {
                    "$ref": "#/components/schemas/InternalID",
                    "description": "Listing identifier"
                  },
                  "client": {
                    "type": "object",
                    "required": [
                      "fName",
                      "lName",
                      "email"
                    ],
                    "properties": {
                      "fName": {
                        "type": "string",
                        "minLength": 2,
                        "description": "First name"
                      },
                      "lName": {
                        "type": "string",
                        "minLength": 2,
                        "description": "Last name"
                      },
                      "email": {
                        "$ref": "#/components/schemas/Email"
                      }
                    }
                  },
                  "persons": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A JSON object",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "redirectUrl"
                  ],
                  "properties": {
                    "redirectUrl": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "4XX": {
            "description": "HTTP Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBase"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BasicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "DateString": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "example": "2020-02-29"
      },
      "Email": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$"
      },
      "ErrorBase": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "text of error"
          }
        }
      },
      "InternalID": {
        "type": "string",
        "pattern": "^([A-Z]{2}[0-9]{2,4}[A-Z]{1})$",
        "description": "Short identifier that uniq for certain entity",
        "example": "XQ02F"
      }
    }
  }
}